# ============================================================
#  MEDEQUIP Backend — Environment Variables (.env.example)
# ============================================================

# Server Port
PORT=8080

# Database Configuration (MySQL)
DB_URL=jdbc:mysql://localhost:3306/medequip_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_secure_db_password
DB_POOL_MAX=10
DB_POOL_MIN_IDLE=5

# Hibernate / JPA
# Use 'validate' or 'none' in production; 'update' in development
DDL_AUTO=validate
SHOW_SQL=false
FORMAT_SQL=false

# JWT Secret (Generate a strong 256-bit Base64 secret in production)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Data Seeder (Disable in production to prevent seeding demo data)
APP_SEED_ENABLED=false

# File Upload / Local Storage
UPLOAD_DIR=uploads
UPLOAD_PRODUCT_DIR=uploads/products
UPLOAD_PROFILE_DIR=uploads/profiles
APP_BASE_URL=https://api.medequip.example.com

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=https://medequip.example.com,https://admin.medequip.example.com

# Logging
APP_LOG_LEVEL=INFO
SECURITY_LOG_LEVEL=WARN
SQL_LOG_LEVEL=WARN
SWAGGER_TRY_IT_OUT=false
