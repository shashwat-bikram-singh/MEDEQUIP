{
  "name": "medequip-root-forwarder",
  "version": "1.0.0",
  "private": true,
  "description": "This file forwards npm commands from the root directory to the tmp-app directory.",
  "scripts": {
    "dev": "npm run dev --prefix tmp-app",
    "build": "npm run build --prefix tmp-app",
    "start": "npm run start --prefix tmp-app",
    "lint": "npm run lint --prefix tmp-app",
    "install": "npm install --prefix tmp-app"
  }
}
